{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "ESNext"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "type/*": ["./src/type/*"]
    }
  },
  "include": ["./src"],
  "exclude": ["node_modules"]
}
